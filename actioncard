<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Learning Modules</title>

<style>
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #121212;
    color: #e0e0e0;
}

header {
    text-align: center;
    padding: 25px;
    background: linear-gradient(90deg, #1f1f1f, #2c2c2c);
}

h1 {
    color: #4fc3f7;
}

h2 {
    color: #aee2fa;
}

/* Flip Cards */
.card-container {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    padding: 20px;
}

.flip-card {
    background: transparent;
    width: 230px;
    height: 200px;
    perspective: 1000px;
}

.flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s;
    transform-style: preserve-3d;
}

.flip-card:hover .flip-card-inner {
    transform: rotateY(180deg);
}

.flip-card-front, .flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    backface-visibility: hidden;
    padding: 20px;
    text-align: center;
}

/* Front */
.flip-card-front {
    background: linear-gradient(135deg, #2c2c2c, #3a3a3a);
}

.flip-card-front h3 {
    color: #4fc3f7;
}

/* Back */
.flip-card-back {
    background: #1e1e1e;
    transform: rotateY(180deg);
}

.flip-card-back button {
    background-color: #4fc3f7;
    border: none;
    padding: 8px 12px;
    border-radius: 5px;
    cursor: pointer;
}

/* Modules */
section.module {
    margin: 20px;
    padding: 20px;
    background-color: #1e1e1e;
    border-radius: 10px;
}
</style>

</head>

<body>

<header>
<h1>📚 Learning Modules</h1>
<p>Explore disaster topics interactively</p>
</header>

<!-- Flip Cards -->
<div class="card-container">

    <!-- Earthquake -->
    <div class="flip-card">
        <div class="flip-card-inner">
            <div class="flip-card-front">
                <h3>🌎 Earthquake</h3>
                <p>Tap to explore</p>
            </div>
            <div class="flip-card-back">
<p>Earthquakes are caused by movement of tectonic plates.</p>
<ul>
<li>Drop, Cover, Hold</li>
<li>Avoid windows</li>
<li>Move to open area</li>
</ul>
            </div>
        </div>
    </div>

    <!-- Flood -->
    <div class="flip-card">
        <div class="flip-card-inner">
            <div class="flip-card-front">
                <h3>🌊 Flood</h3>
                <p>Tap to explore</p>
            </div>
            <div class="flip-card-back">
                <p>Wildfires spread rapidly in dry conditions.</p>
<ul>
<li>Clear dry vegetation</li>
<li>Evacuate early</li>
<li>Wear protective clothing</li>
</ul>
            </div>
        </div>
    </div>

    <!-- Cyclone -->
    <div class="flip-card">
        <div class="flip-card-inner">
            <div class="flip-card-front">
                <h3>🌪 Cyclone</h3>
                <p>Tap to explore</p>
            </div>
            <div class="flip-card-back">
               <p>Cyclones form over warm oceans with strong winds.</p>
<ul>
<li>Stay indoors</li>
<li>Secure property</li>
<li>Follow alerts</li>
</ul>
            </div>
        </div>
    </div>

    <!-- Wildfire -->
    <div class="flip-card">
        <div class="flip-card-inner">
            <div class="flip-card-front">
                <h3>🔥 Wildfire</h3>
                <p>Tap to explore</p>
            </div>
            <div class="flip-card-back">
                <p>Wildfires spread rapidly in dry conditions.</p>
               <ul>
<li>Clear dry vegetation</li>
<li>Evacuate early</li>
<li>Wear protective clothing</li>
</ul>
            </div>
        </div>
    </div>

</div>

<!-- JS -->
<script>
function scrollToSection(id) {
    document.getElementById(id).scrollIntoView({
        behavior: "smooth"
    });
}
</script>

</body>
</html>
